{varType App\Entity\Page $page}
{varType App\Helpers\FlashMessage[] $flashes}
{varType ?App\Entity\LayoutBlock $navBlock}

<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title|stripHtml} | {/ifset}Kobra</title>
	{asset 'front.js'}
</head>
<body>

	{* The header exists only when the displayed CMS page has a nav block assigned —
	   there is no default menu and nothing hints at the admin section or login. *}
	{var $navBlock = isset($page) ? $page->getNavBlock() : null}
	{var $navBrand = trim($navBlock?->getContent()['brand'] ?? '') ?: 'Kobra'}
	{var $navLogo = trim($navBlock?->getContent()['logo_url'] ?? '')}
	{var $navStudio = $navBlock?->getStyle() === App\Entity\LayoutBlock::STYLE_STUDIO}

	<div class="site-canvas">
		{* "studio": logo + a small vertical link list, aligned with the wide masonry grid *}
		<header n:if="$navStudio" class="site-header">
			<div class="site-header-inner">
				<a class="site-header-brand" n:href=":Front:Home:default">
					{if $navLogo !== ''}<img src="{$navLogo}" alt="{$navBrand}">{else}{$navBrand}{/if}
				</a>
				<nav n:if="$navBlock->getLinks() || $navBlock->getActiveMenus()" class="site-header-menu" aria-label="Hlavní navigace">
					<ul>
						<li n:foreach="$navBlock->getLinks() as $link"><a href="{$link['url']}">{$link['label']}</a></li>
						<li n:foreach="$navBlock->getActiveMenus() as $menu" class="dropdown">
							{varType App\Entity\Menu $menu}
							<a href="#" class="dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">{$menu->getName()}</a>
							<ul class="dropdown-menu">
								<li n:foreach="$menu->getLinks() as $link"><a class="dropdown-item" href="{$link['url']}">{$link['label']}</a></li>
							</ul>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<nav n:if="$navBlock !== null && !$navStudio" class="navbar navbar-expand-md bg-white shadow-sm">
			<div class="container">
				<a class="navbar-brand text-primary" n:href=":Front:Home:default">
					{if $navLogo !== ''}<img src="{$navLogo}" alt="{$navBrand}" class="navbar-logo">{else}{$navBrand}{/if}
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
				        aria-controls="mainNav" aria-expanded="false" aria-label="Přepnout navigaci">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div id="mainNav" class="collapse navbar-collapse">
					<ul class="navbar-nav me-auto">
						<li n:foreach="$navBlock->getLinks() as $link" class="nav-item">
							<a class="nav-link" href="{$link['url']}">{$link['label']}</a>
						</li>
						{* Assigned menus become dropdowns, labelled with the menu name *}
						{foreach $navBlock->getActiveMenus() as $menu}
							{varType App\Entity\Menu $menu}
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									{$menu->getName()}
								</a>
								<ul class="dropdown-menu">
									<li n:foreach="$menu->getLinks() as $link"><a class="dropdown-item" href="{$link['url']}">{$link['label']}</a></li>
								</ul>
							</li>
						{/foreach}
					</ul>
				</div>
			</div>
		</nav>

		<main n:class="$navStudio ? 'pt-0 pb-5' : 'py-5'">
			<div class="container">
				{foreach $flashes as $flash}
					{varType App\Helpers\FlashMessage $flash}
					<div class="alert alert-{$flash->type} alert-dismissible fade show mb-4" role="alert">
						{$flash->message}
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				{/foreach}

				{include content}
			</div>
		</main>
	</div>

	{var $footerBlock = isset($page) ? $page->getFooterBlock() : null}
	{var $footerText = trim($footerBlock?->getContent()['text'] ?? '')}
	{var $footerSlides = array_values(array_filter(
		is_array($footerBlock?->getContent()['carousel'] ?? null) ? $footerBlock->getContent()['carousel'] : [],
		fn ($s) => is_array($s) && trim($s['image_url'] ?? '') !== '',
	))}
	<footer n:if="$footerText !== '' || count($footerSlides)" class="py-4">
		{var $copies = max(2, (int) ceil(12 / max(1, count($footerSlides))))}
		<div n:if="count($footerSlides)" n:class="footer-carousel, $footerText !== '' ? 'mb-4'" aria-label="Galerie">
			<div class="footer-carousel-track" style="--carousel-copies: {$copies}; --carousel-duration: {$copies * count($footerSlides) * 3}s">
				{for $copy = 0; $copy < $copies; $copy++}
					{foreach $footerSlides as $slide}
						{var $slideLink = trim($slide['link_url'] ?? '')}
						{* every repeat after the first is presentational only — hidden from assistive tech *}
						<a n:if="$slideLink !== ''" href="{$slideLink}" class="footer-carousel-item" n:attr="aria-hidden: $copy > 0 ? 'true' : null, tabindex: $copy > 0 ? '-1' : null">
							<img src="{$slide['image_url']}" alt="{$slide['alt'] ?? ''}" loading="lazy">
						</a>
						<div n:if="$slideLink === ''" class="footer-carousel-item" n:attr="aria-hidden: $copy > 0 ? 'true' : null">
							<img src="{$slide['image_url']}" alt="{$slide['alt'] ?? ''}" loading="lazy">
						</div>
					{/foreach}
				{/for}
			</div>
		</div>
		<div n:if="$footerText !== ''" class="container small text-muted rich-text">{$footerText|noescape}</div>
	</footer>

</body>
</html>
