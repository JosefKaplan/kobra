<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title|stripHtml} | {/ifset}Administrace</title>
	{asset 'admin.js'}
</head>
<body>

	<nav id="topbar" class="navbar navbar-dark px-3 d-flex align-items-center justify-content-between">
		<span class="navbar-brand mb-0">
			<i class="bi bi-gear-fill me-2"></i>Administrace
		</span>
		<a class="text-light small text-decoration-none" href="{link :Front:Home:default}">
			<i class="bi bi-box-arrow-up-right me-1"></i>Zobrazit web
		</a>
	</nav>

	<div id="main" class="p-4">
		{foreach $flashes as $flash}
			<div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
				{$flash->message}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{/foreach}

		{include content}
	</div>

</body>
</html>
