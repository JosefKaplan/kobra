{layout '../@layout.latte'}
{import '../Page/_componentEditor.latte'}
{varType ?App\Entity\LayoutBlock $block}
{varType string $type}
{varType array $carousel}

{var $typeLabel = $type === 'nav' ? 'navigace' : 'patička'}

{block title}{$block !== null ? 'Upravit' : 'Nová'} {$typeLabel}{/block}

{block content}
<div class="mb-4">
	<a n:href="default" class="btn btn-outline-secondary btn-sm mb-3">
		<i class="bi bi-arrow-left me-1"></i>Zpět na seznam
	</a>
	<h1 class="h3 mb-0">
		{if $type === 'nav'}
			<i class="bi bi-menu-button-wide me-2 text-primary"></i>
		{else}
			<i class="bi bi-layout-text-window-reverse me-2 text-primary"></i>
		{/if}
		{$block !== null ? 'Upravit' : 'Nová'} {$typeLabel}{if $block !== null} – {$block->getName()}{/if}
	</h1>
</div>

<div class="card shadow-sm" style="max-width: {$type === 'nav' ? '720px' : '960px'}">
	<div class="card-body">
		{if $type === 'nav'}
			{control blockForm}
			<div class="form-text mt-2">Jeden odkaz na řádek ve tvaru <code>Text | URL</code>.</div>
		{else}
			{* Rendered by hand so the carousel rows (plain inputs, not form controls — read from the
			   raw POST in LayoutPresenter) sit inside the <form> before the submit button. *}
			<form n:name="blockForm">
				{inputError name}
				<div class="mb-3">
					{label name /}
					{input name}
				</div>
				<div class="mb-4">
					{label content /}
					{input content}
					{inputError content}
				</div>

				<div class="form-label fw-semibold">Carousel (nepovinný)</div>
				<div class="form-text mb-2">Obrázky rolují nad textem patičky v nekonečné smyčce, v tomto pořadí. Každý může odkazovat na URL.</div>
				{include imageListEditor, field: 'carousel', idPrefix: 'footer-carousel', items: $carousel, withLink: true, addLabel: 'Přidat obrázek'}

				<div class="mt-4">
					{input send}
				</div>
			</form>
		{/if}
	</div>
</div>
{/block}
