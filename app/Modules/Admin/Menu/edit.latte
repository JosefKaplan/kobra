{layout '../@layout.latte'}
{varType ?App\Entity\Menu $menu}

{block title}{$menu !== null ? 'Upravit menu' : 'Nové menu'}{/block}

{block content}
<div class="mb-4">
	<a n:href="default" class="btn btn-outline-secondary btn-sm mb-3">
		<i class="bi bi-arrow-left me-1"></i>Zpět na seznam
	</a>
	<h1 class="h3 mb-0">
		<i class="bi bi-list me-2 text-primary"></i>
		{$menu !== null ? 'Upravit menu' : 'Nové menu'}{if $menu !== null} – {$menu->getName()}{/if}
	</h1>
</div>

<div class="card shadow-sm" style="max-width: 720px">
	<div class="card-body">
		{control menuForm}
		<div class="form-text mt-2">Jeden odkaz na řádek ve tvaru <code>Text | URL</code>.</div>
	</div>
</div>
{/block}
