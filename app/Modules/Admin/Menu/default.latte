{layout '../@layout.latte'}

{block title}Menu{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="h3 mb-0">
		<i class="bi bi-list me-2 text-primary"></i>Menu
	</h1>
	<a n:href="add" class="btn btn-primary btn-sm">
		<i class="bi bi-plus-lg me-1"></i>Nové menu
	</a>
</div>

<p class="text-muted">
	Menu je pojmenovaný seznam odkazů. V navigaci
	(<a n:href="Layout:default">Navigace a patičky</a>) je přiřadíte zaškrtnutím —
	na webu se pak zobrazí jako rozbalovací nabídka s názvem menu.
</p>

<div class="card shadow-sm">
	<div class="card-body p-0">
		{control menusGrid}
	</div>
</div>
{/block}
