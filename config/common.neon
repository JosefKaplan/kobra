# see https://doc.nette.org/en/configuring

parameters:
	database:
		host: localhost
		port: 3306
		name: kobra
		user: root
		password: 'root'
		# Doctrine DBAL platform hint — must match the real server.
		# Deployment target is MariaDB; the '-MariaDB' suffix is what makes DBAL
		# pick MariaDBPlatform instead of MySQLPlatform (JSON handling, DDL, …).
		#   MariaDB:  '10.11.11-MariaDB'  (use the hoster's real version — SELECT VERSION())
		#   MySQL 8:  '8.0'               (only if you develop locally against MySQL)
		# Override in config/local.neon per environment.
		serverVersion: '10.11.11-MariaDB'


application:
	mapping:
		Front: App\Modules\Front\**Presenter
		Admin: App\Modules\Admin\**Presenter


# Legacy Nette Database (kept for backward compatibility with datagrid)
database:
	dsn: 'mysql:host=%database.host%;port=%database.port%;dbname=%database.name%;charset=utf8mb4'
	user: %database.user%
	password: %database.password%
	options:
		lazy: true


session:
	savePath: %tempDir%/sessions
	expiration: 14 days


assets:
	mapping:
		default:
			type: vite
			path: assets


latte:
	strictParsing: yes


di:
	export:
		parameters: no
		tags: no


# ── Doctrine DBAL ────────────────────────────────────────────────────────────
extensions:
	dbal: Nettrine\DBAL\DI\DbalExtension
	orm: Nettrine\ORM\DI\OrmExtension
	migrations: Nettrine\Migrations\DI\MigrationsExtension


dbal:
	connections:
		default:
			driver: pdo_mysql
			host: %database.host%
			port: %database.port%
			dbname: %database.name%
			user: %database.user%
			password: %database.password%
			charset: utf8mb4
			serverVersion: %database.serverVersion%


# ── Doctrine ORM ─────────────────────────────────────────────────────────────
orm:
	managers:
		default:
			connection: default
			mapping:
				App\Entity:
					type: attributes
					directories: [%appDir%/Entity]
					namespace: App\Entity


# ── Doctrine Migrations ──────────────────────────────────────────────────────
migrations:
	directories:
		App\Migrations: %appDir%/../migrations
	table: doctrine_migrations
