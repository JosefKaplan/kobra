services:
	- App\Core\RouterFactory::createRouter
	- App\Core\Security\Authenticator
	- App\Helpers\RichTextSanitizer(%tempDir%/htmlpurifier)
	- App\Helpers\ImageUploader(%wwwDir%/uploads)
	- App\Helpers\Thumbnailer(%wwwDir%/uploads, %wwwDir%/thumbs)
	- App\Models\UploadCleaner(%wwwDir%/uploads)
	- App\Models\UploadBrowser(%wwwDir%/uploads)
	- App\Console\ExportContentCommand(%appDir%/../migrations/data/content-snapshot.json)
	- App\Console\GenerateThumbnailsCommand
	# Doctrine EventSubscriber — Nettrine hooks every such service into the EntityManager
	- App\Models\UploadCleanupListener


search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
			- *Manager
			- *Presenter
